@model IEnumerable<buoi3.Models.Product>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Products Management</h2>
        <a asp-action="Add" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
        </a>
    </div>

    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-muted">Tìm kiếm theo tên</label>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Nhập tên sản phẩm cần tìm..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Lọc theo danh mục</label>
                    <select name="categoryId" asp-items="@ViewBag.Categories" class="form-select">
                        <option value="">-- Tất cả danh mục --</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end justify-content-start mt-4">
                    <button type="submit" class="btn btn-primary me-2 px-3">
                        Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Tên</th>
                    <th class="text-end" style="width: 140px;">Giá</th>
                    <th>Mô tả</th>
                    <th style="width: 120px;" class="text-center">Ảnh sản phẩm</th>
                    <th>Loại</th>
                    <th style="width: 180px;" class="text-center">Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>

                            <td class="text-end text-danger fw-bold">@item.Price.ToString("N0") đ</td>

                            <td>@item.Description</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="img-thumbnail" style="max-width: 70px; max-height: 70px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có ảnh</span>
                                }
                            </td>
                            <td>
                                @if (item.Category != null)
                                {
                                    <span class="badge bg-secondary">@item.Category.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa phân loại</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Display" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">View</a>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-primary btn-sm mx-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted fs-5">
                            Không tìm thấy sản phẩm nào phù hợp!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>