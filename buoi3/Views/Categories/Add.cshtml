@model buoi3.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục";
}

<div class="container my-4" style="max-width: 600px;">
    <h2>Create Category</h2>
    <form asp-action="Add" method="post" class="mt-3">
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label">Tên danh mục</label>
            <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-success">Save</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </form>
</div>